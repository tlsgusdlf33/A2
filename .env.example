# =========================================================
#  autopub 환경변수 예시  →  .env 로 복사해서 채우세요
#  (.env 는 .gitignore 에 있으며 절대 커밋되지 않습니다)
# =========================================================

# ---------- LLM (본문/스크립트 생성) ----------
# provider: gemini | anthropic | openai_compatible
LLM_PROVIDER=gemini

# 1) Gemini 무료 티어 (권장 기본값) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 2) Anthropic Claude (유료·최고 품질)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# 3) OpenAI 호환 무료 엔드포인트(Groq / OpenRouter 무료 모델 등)
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile

# ---------- 이미지 생성 (news 스타일) ----------
# 기본값(pollinations)은 키가 필요 없습니다. 비워 두면 그대로 동작합니다.
IMAGEGEN_PROVIDER=pollinations
# together 사용 시
TOGETHER_API_KEY=
# cloudflare 사용 시
CF_ACCOUNT_ID=
CF_API_TOKEN=

# ---------- 스톡 영상/이미지 (무료 키) ----------
# 카드 스타일(기본)에서는 쓰지 않습니다. 블로그 본문 이미지와
# video.style=broll 일 때만 필요합니다.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---------- 티스토리 (Open API 종료 → 브라우저 자동화) ----------
TISTORY_BLOG_NAME=myblog          # myblog.tistory.com 의 myblog
TISTORY_KAKAO_ID=
TISTORY_KAKAO_PW=
# 로그인 세션 저장 경로(최초 1회 수동 로그인 후 재사용 권장)
TISTORY_STORAGE_STATE=secrets/tistory_state.json

# ---------- YouTube Data API v3 ----------
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# ---------- TikTok Content Posting API ----------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_TOKEN_FILE=secrets/tiktok_token.json
